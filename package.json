{
  "name": "nexus-admin-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Nexus Admin - Reusable product grade admin dashboard and marketing UI framework",
  "scripts": {
    "dev": "pnpm --filter @nexus/admin dev",
    "dev:marketing": "pnpm --filter @nexus/marketing dev",
    "build": "pnpm -r --if-present build",
    "build:admin": "pnpm --filter @nexus/admin build",
    "start": "pnpm --filter @nexus/admin start",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "jsdom": "^30.1.2",
    "next": "^15.1.7",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
