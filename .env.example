# Copy to apps/admin/.env.local and adjust. Never commit real secrets.

# Public (exposed to the browser) ------------------------------------------
NEXT_PUBLIC_APP_NAME="Nexus Admin"
NEXT_PUBLIC_DEFAULT_THEME=modern-saas

# Base URL of your backend implementing docs/API_CONTRACT.md.
# Leave empty to use the built-in in-memory demo API (development / demos only).
NEXT_PUBLIC_API_BASE_URL=

# "true" enables the demo auth adapter and sample data. MUST be false in production.
NEXT_PUBLIC_DEMO_MODE=true

# Server-only ----------------------------------------------------------------
# Extra origins allowed by the Content-Security-Policy connect-src directive
# (space separated), e.g. your API origin.
CSP_CONNECT_SRC=
# Set to "true" on https-only production hosts to add the CSP upgrade-insecure-requests directive.
CSP_UPGRADE_INSECURE_REQUESTS=false

# Marketing site (apps/marketing) -------------------------------------------
# Canonical origin used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# Contact form: POSTs JSON here if set (its origin is added to the CSP), otherwise opens a mailto: link.
NEXT_PUBLIC_CONTACT_ENDPOINT=
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Set to "off" to disable GSAP scroll scenes (then `gsap` can be removed from packages/ui).
NEXT_PUBLIC_SCROLL_ANIMATION=on

# Cross-links between the two apps (shown only when set; default to localhost in development).
NEXT_PUBLIC_MARKETING_URL=http://localhost:3200
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
