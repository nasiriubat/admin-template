{
  "id": "/",
  "name": "Nexus Admin",
  "short_name": "Nexus",
  "description": "Reusable, themeable admin dashboard framework.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0f19",
